          [
            {
              "node": "Set IG ID",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Post Twitter": {
        "main": [
          [
            {
              "node": "Set Twitter ID",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Wait": {
        "main": [
          [
            {
              "node": "Fetch Metrics",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Fetch Metrics": {
        "main": [
          [
            {
              "node": "Map Views",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Map Views": {
        "main": [
          [
            {
              "node": "High Engagement?",
              "type": "main",
