[
  {
    "name": "Trend Scraper",
    "nodes": [
      {
        "parameters": {
          "cronExpression": "0 8 * * *",
          "timezone": "America/Los_Angeles"
        },
        "id": 1,
        "name": "Daily Cron",
        "type": "n8n-nodes-base.cron",
        "typeVersion": 1,
        "position": [
          100,
          100
        ]
      },
      {
        "parameters": {
          "url": "={{$env.TRENDTOK_URL}}?api_key={{$env.TRENDTOK_TOKEN}}",
          "method": "GET",
          "responseFormat": "json"
        },
        "id": 2,
        "name": "Fetch Trends",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 2,
        "position": [
          300,
          100
        ]
      },
      {
        "parameters": {
          "model": "gpt-4o-preview",
          "prompt": "={{'Generate content ideas from ' + JSON.stringify($json).slice(0,3000)}}"
        },
        "id": 3,
        "name": "Process Trends",
        "type": "n8n-nodes-base.openai",
        "typeVersion": 1,
        "position": [
          500,
          100
        ]
      },
      {
        "parameters": {
          "operation": "create",
          "base": "PersonasContentIdeas",
          "table": "Content Ideas",
          "fields": {
            "Persona": "={{$json.persona}}",
            "Idea": "={{$json.idea}}",
            "Caption": "={{$json.caption}}",
            "Status": "pending"
          }
        },
        "id": 4,
        "name": "Store Ideas",
        "type": "n8n-nodes-base.airtable",
        "typeVersion": 2,
        "position": [
          700,
          100
        ]
      }
    ],
    "connections": {
      "Daily Cron": {
        "main": [
          [
            {
              "node": "Fetch Trends",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Fetch Trends": {
        "main": [
          [
            {
              "node": "Process Trends",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Process Trends": {
        "main": [
          [
            {
              "node": "Store Ideas",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    }
  },
  {
    "name": "Content Factory",
    "nodes": [
      {
        "parameters": {
          "cronExpression": "0 * * * *",
          "timezone": "America/Los_Angeles"
        },
        "id": 10,
        "name": "Cron Hourly",
        "type": "n8n-nodes-base.cron",
        "typeVersion": 1,
        "position": [
          100,
          300
        ]
      },
      {
        "parameters": {
          "operation": "list",
          "base": "Personas",
          "table": "Personas",
          "filtersUi": {
            "filter": [
              {
                "field": "Status",
                "condition": "equals",
                "value": "active"
              }
            ]
          }
        },
        "id": 11,
        "name": "Get Active Personas",
        "type": "n8n-nodes-base.airtable",
        "typeVersion": 2,
        "position": [
          300,
          200
        ]
      },
      {
        "parameters": {
          "operation": "list",
          "base": "PersonasContentIdeas",
          "table": "Content Ideas",
          "filtersUi": {
            "filter": [
              {
                "field": "Status",
                "condition": "equals",
                "value": "pending"
              }
            ]
          }
        },
        "id": 12,
        "name": "Get Pending Ideas",
        "type": "n8n-nodes-base.airtable",
        "typeVersion": 2,
        "position": [
          300,
          400
        ]
      },
      {
        "parameters": {
          "functionCode": "const persona = $input.all()[0].items[0].json; const idea = $input.all()[1].items[0].json; return [{json:{...persona,...idea,prompt:`${persona.PromptSeed} ${idea.Idea}`,negPrompt:persona.Negative,personaName:persona.Name}}];"
        },
        "id": 13,
        "name": "Prepare Prompts",
        "type": "n8n-nodes-base.function",
        "typeVersion": 1,
        "position": [
          500,
          300
        ]
      },
      {
        "parameters": {
          "url": "https://api.graydient.ai/generate",
          "method": "POST",
          "responseFormat": "file",
          "jsonParameters": true,
          "bodyParametersJson": "={{ { prompt: $json.prompt, neg_prompt: $json.negPrompt, model: 'hd', width: 1024, height: 1024 } }}"
        },
        "id": 14,
        "name": "Generate Image",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 2,
        "position": [
          700,
          300
        ]
      },
      {
        "parameters": {
          "url": "={{$env.FACE_API_URL}}/verify",
          "method": "POST",
          "responseFormat": "json",
          "sendBinaryData": true,
          "binaryPropertyName": "data"
        },
        "id": 15,
        "name": "Face API",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 2,
        "position": [
          900,
          300
        ]
      },
      {
        "parameters": {
          "values": {
            "boolean": [
              {
                "name": "face_pass",
                "value": "={{($node['Face API'].json.data?.similarity ?? $node['Face API'].json.similarity) >= 0.70}}"
              }
            ]
          }
        },
        "id": 16,
        "name": "Map Face Result",
        "type": "n8n-nodes-base.set",
        "typeVersion": 1,
        "position": [
          1100,
          300
        ]
      },
      {
        "parameters": {
          "url": "={{$env.QG_URL}}/check",
          "method": "POST",
          "responseFormat": "json",
          "sendBinaryData": true,
          "binaryPropertyName": "data"
        },
        "id": 17,
        "name": "QG Check",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 2,
        "position": [
          1300,
          300
        ]
      },
      {
        "parameters": {
          "values": {
            "boolean": [
              {
                "name": "quality",
                "value": "={{($json.data?.clip_score ?? $json.clip_score) >= 0.25}}"
              }
            ]
          }
        },
        "id": 18,
        "name": "Map Quality",
        "type": "n8n-nodes-base.set",
        "typeVersion": 1,
        "position": [
          1500,
          300
        ]
      },
      {
        "parameters": {
          "conditions": {
            "boolean": [
              {
                "value1": "={{$json.face_pass && $json.quality}}"
              }
            ]
          }
        },
        "id": 19,
        "name": "QA Pass?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2,
        "position": [
          1700,
          300
        ]
      },
      {
        "parameters": {
          "fileName": "Assets/Approved/{{$json.personaName}}/{{Date.now()}}.jpg",
          "dataPropertyName": "data"
        },
        "id": 20,
        "name": "Save Approved",
        "type": "n8n-nodes-base.writeBinaryFile",
        "typeVersion": 1,
        "position": [
          1900,
          250
        ]
      },
      {
        "parameters": {
          "operation": "update",
          "base": "PersonasContentIdeas",
          "table": "Content Ideas",
          "id": "={{$json.id}}",
          "fields": {
            "Status": "ready",
            "FilePath": "={{$node['Save Approved'].parameter.fileName}}"
          }
        },
        "id": 21,
        "name": "Mark Ready",
        "type": "n8n-nodes-base.airtable",
        "typeVersion": 2,
        "position": [
          2100,
          250
        ]
      },
      {
        "parameters": {
          "url": "={{$env.SLACK_WEBHOOK}}",
          "method": "POST",
          "jsonParameters": true,
          "bodyParametersJson": "={{ { text: '❌ QA failed for ' + $json.personaName } }}"
        },
        "id": 22,
        "name": "Slack Fail",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 2,
        "position": [
          1900,
          350
        ]
      },
      {
        "parameters": {
          "options": {},
          "delete": "binary,data"
        },
        "id": 23,
        "name": "Remove Keys",
        "type": "n8n-nodes-base.removeKeys",
        "typeVersion": 1,
        "position": [
          1850,
          350
        ]
      }
    ],
    "connections": {
      "Cron Hourly": {
        "main": [
          [
            {
              "node": "Get Active Personas",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Get Active Personas": {
        "main": [
          [
            {
              "node": "Prepare Prompts",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Get Pending Ideas": {
        "main": [
          [
            {
              "node": "Prepare Prompts",
              "type": "main",
              "index": 1
            }
          ]
        ]
      },
      "Prepare Prompts": {
        "main": [
          [
            {
              "node": "Generate Image",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Generate Image": {
        "main": [
          [
            {
              "node": "Face API",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Face API": {
        "main": [
          [
            {
              "node": "Map Face Result",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Map Face Result": {
        "main": [
          [
            {
              "node": "QG Check",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "QG Check": {
        "main": [
          [
            {
              "node": "Map Quality",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Map Quality": {
        "main": [
          [
            {
              "node": "QA Pass?",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "QA Pass?": {
        "main": [
          [
            {
              "node": "Save Approved",
              "type": "main",
              "index": 0
            }
          ],
          [
            {
              "node": "Remove Keys",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Save Approved": {
        "main": [
          [
            {
              "node": "Mark Ready",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Remove Keys": {
        "main": [
          [
            {
              "node": "Slack Fail",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    }
  },
  {
    "name": "Distribution Router",
    "nodes": [
      {
        "parameters": {
          "cronExpression": "*/10 * * * *",
          "timezone": "America/Los_Angeles"
        },
        "id": 30,
        "name": "Cron Posts",
        "type": "n8n-nodes-base.cron",
        "typeVersion": 1,
        "position": [
          100,
          600
        ]
      },
      {
        "parameters": {
          "operation": "list",
          "base": "PersonasContentIdeas",
          "table": "Content Ideas",
          "filtersUi": {
            "filter": [
              {
                "field": "Status",
                "condition": "equals",
                "value": "ready"
              }
            ]
          }
        },
        "id": 31,
        "name": "Get Ready",
        "type": "n8n-nodes-base.airtable",
        "typeVersion": 2,
        "position": [
          300,
          600
        ]
      },
      {
        "parameters": {
          "operation": "executeWorkflow",
          "workflowId": "Compliance Gate"
        },
        "id": 32,
        "name": "Compliance",
        "type": "n8n-nodes-base.executeWorkflow",
        "typeVersion": 1,
        "position": [
          500,
          600
        ]
      },
      {
        "parameters": {
          "url": "={{$env.METRICOOL_URL}}/posts",
          "method": "POST",
          "sendBinaryData": true,
          "binaryPropertyName": "data",
          "jsonParameters": true,
          "bodyParametersJson": "={\"account\": $env.IG_ACCOUNT_ID, \"caption\": $json.caption}"
        },
        "id": 33,
        "name": "Post IG",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 2,
        "position": [
          700,
          550
        ]
      },
      {
        "parameters": {
          "url": "https://api.twitter.com/2/tweets",
          "method": "POST",
          "jsonParameters": true,
          "bodyParametersJson": "={\"text\": $json.caption}"
        },
        "id": 34,
        "name": "Post Twitter",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 2,
        "position": [
          700,
          650
        ]
      },
      {
        "parameters": {
          "waitTime": "6h"
        },
        "id": 35,
        "name": "Wait",
        "type": "n8n-nodes-base.wait",
        "typeVersion": 1,
        "position": [
          900,
          600
        ]
      },
      {
        "parameters": {
          "url": "={{$env.METRICOOL_URL}}/analytics",
          "method": "GET",
          "queryParametersUi": {
            "parameter": [
              {
                "name": "postId",
                "value": "={{$json.postId}}"
              }
            ]
          },
          "responseFormat": "json"
        },
        "id": 36,
        "name": "Fetch Metrics",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 2,
        "position": [
          1100,
          600
        ]
      },
      {
        "parameters": {
          "values": {
            "number": [
              {
                "name": "views",
                "value": "={{ $json.data?.engagement?.views || ($json[0] && $json[0].engagement.views) }}"
              }
            ]
          }
        },
        "id": 37,
        "name": "Map Views",
        "type": "n8n-nodes-base.set",
        "typeVersion": 1,
        "position": [
          1300,
          600
        ]
      },
      {
        "parameters": {
          "conditions": {
            "number": [
              {
                "value1": "={{$json.views}}",
                "operation": "greater",
                "value2": 10000
              }
            ]
          }
        },
        "id": 38,
        "name": "High Engagement?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2,
        "position": [
          1500,
          600
        ]
      },
      {
        "parameters": {
          "url": "https://graph.facebook.com/v18.0/act_{{$env.META_AD_ACCOUNT}}/promoted_posts",
          "method": "POST",
          "responseFormat": "json",
          "jsonParameters": true,
          "bodyParametersJson": "={\"promoted_post_id\": $json.postId, \"daily_budget\": 2000, \"currency\": \"USD\"}"
        },
        "id": 39,
        "name": "Boost Post",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 2,
        "position": [
          1700,
          550
        ]
      },
      {
        "parameters": {
          "operation": "update",
          "base": "PersonasContentIdeas",
          "table": "Content Ideas",
          "id": "={{$json.id}}",
          "fields": {
            "Status": "posted"
          }
        },
        "id": 40,
        "name": "Mark Posted",
        "type": "n8n-nodes-base.airtable",
        "typeVersion": 2,
        "position": [
          1700,
          650
        ]
      },
      {
        "parameters": {
          "filePath": "={{$json.FilePath}}"
        },
        "id": 41,
        "name": "Read File IG",
        "type": "n8n-nodes-base.readBinaryFile",
        "typeVersion": 1,
        "position": [
          600,
          500
        ]
      },
      {
        "parameters": {
          "values": {
            "string": [
              {
                "name": "postId",
                "value": "={{$json.post_id || $json.data?.id || $json.id}}"
              }
            ]
          }
        },
        "id": 42,
        "name": "Set IG ID",
        "type": "n8n-nodes-base.set",
        "typeVersion": 1,
        "position": [
          850,
          500
        ]
      },
      {
        "parameters": {
          "values": {
            "string": [
              {
                "name": "postId",
                "value": "={{$json.post_id || $json.data?.id || $json.id}}"
              }
            ]
          }
        },
        "id": 43,
        "name": "Set Twitter ID",
        "type": "n8n-nodes-base.set",
        "typeVersion": 1,
        "position": [
          850,
          650
        ]
      }
    ],
    "connections": {
