  {
    "name": "Telegram Admin Bot",
    "nodes": [
      {
        "parameters": {
          "updateTypes": [
            "message"
          ],
          "botToken": "={{$env.TELEGRAM_BOT_TOKEN}}"
        },
        "id": 50,
        "name": "Telegram Trigger",
        "type": "n8n-nodes-base.telegramTrigger",
        "typeVersion": 1,
        "position": [
          100,
          900
        ]
      },
      {
        "parameters": {
          "conditions": {
            "string": [
              {
                "value1": "={{String($json.message.chat.id)}}",
                "operation": "equals",
                "value2": "={{$env.TELEGRAM_ADMIN_ID}}"
              }
            ]
          }
        },
        "id": 51,
        "name": "Is Admin?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2,
        "position": [
          300,
          900
        ]
      },
      {
        "parameters": {
          "functionCode": "const m=$json.message.text;return [{json:{cmd:m.split(' ')[0],arg:m.split(' ')[1]||'',chat:$json.message.chat.id}}];"
        },
        "id": 52,
        "name": "Parse",
        "type": "n8n-nodes-base.function",
        "typeVersion": 1,
        "position": [
          500,
          900
        ]
      },
      {
        "parameters": {
          "conditions": {
            "string": [
              {
                "value1": "={{$json.cmd}}",
                "operation": "equals",
                "value2": "/approve"
              }
            ]
          }
        },
        "id": 53,
        "name": "Is Approve?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2,
        "position": [
          700,
          850
        ]
      },
      {
        "parameters": {
          "conditions": {
            "string": [
              {
                "value1": "={{$json.cmd}}",
                "operation": "equals",
                "value2": "/reject"
              }
            ]
          }
        },
        "id": 54,
        "name": "Is Reject?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2,
        "position": [
          700,
          950
        ]
      },
      {
        "parameters": {
          "operation": "update",
          "base": "PersonasContentIdeas",
          "table": "Content Ideas",
          "id": "={{$json.arg}}",
          "fields": {
            "Status": "approved"
          }
        },
        "id": 55,
        "name": "Mark Approved",
        "type": "n8n-nodes-base.airtable",
        "typeVersion": 2,
        "position": [
          900,
          800
        ]
      },
      {
        "parameters": {
          "chatId": "={{$json.chat}}",
          "text": "Approved"
        },
        "id": 56,
        "name": "Reply Approved",
        "type": "n8n-nodes-base.telegram",
        "typeVersion": 1,
        "position": [
          1100,
          800
        ]
      },
      {
        "parameters": {
          "operation": "update",
          "base": "PersonasContentIdeas",
          "table": "Content Ideas",
          "id": "={{$json.arg}}",
          "fields": {
            "Status": "rejected"
          }
        },
        "id": 57,
        "name": "Mark Rejected",
        "type": "n8n-nodes-base.airtable",
        "typeVersion": 2,
        "position": [
          900,
          1000
        ]
      },
      {
        "parameters": {
          "chatId": "={{$json.chat}}",
          "text": "Rejected"
        },
        "id": 58,
        "name": "Reply Rejected",
        "type": "n8n-nodes-base.telegram",
        "typeVersion": 1,
        "position": [
          1100,
          1000
        ]
      }
    ],
    "connections": {
      "Telegram Trigger": {
        "main": [
          [
            {
              "node": "Is Admin?",
              "type": "main",
              "index": 0
            }
          ]
